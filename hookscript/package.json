{
  "name": "hookscript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hookscript: compiler, reference interpreter, fuzzer and drafter for hookrz Custom blocks",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./compiler/src/index.ts",
    "./compiler": "./compiler/src/index.ts",
    "./fuzz": "./fuzz/fuzz.ts",
    "./drafter": "./drafter/draft.ts"
  },
  "scripts": {
    "test": "node compiler/test/compiler.test.ts && node compiler/test/parity.ts && node fuzz/run.ts examples/*.hs && node drafter/test-mock.ts",
    "test:vm": "cd vm && cargo test --release",
    "parity": "node compiler/test/parity.ts --cases 1000",
    "fuzz": "node fuzz/run.ts --json fuzz/report.json examples/*.hs",
    "honeypots": "node fuzz/run.ts --trades 3000 fuzz/honeypots/*.hs",
    "drafter": "node drafter/test.ts",
    "examples": "node compiler/bin/hsc.ts examples/*.hs",
    "bench": "node vm/bench/cu.ts --json vm/bench/cu.json"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "*"
  }
}
