    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "decimal.js": "10.6.0",
    "fastify": "5.12.5",
    "litesvm": "1.5.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
